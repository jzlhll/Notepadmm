<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Label?>
<?import com.jfoenix.controls.JFXRippler?>
<?import com.allan.uilibs.controls.Drag2ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>
<?import com.allan.uilibs.controls.RotatablePaneLayouter?>
<?import javafx.scene.layout.StackPane?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="outAnchorPane"
            prefHeight="650" prefWidth="500">
    <HBox fx:id="floatingControlsLayout" prefHeight="30" minHeight="30" maxHeight="30"
          style="-fx-background-color: -au-tab-header-background-color;"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <padding>
            <Insets left="10"/>
        </padding>
        <JFXRippler styleClass="jfx-rippler" layoutY="3">
            <HBox.margin>
                <Insets left="10"/>
            </HBox.margin>
            <Label maxHeight="1.8" fx:id="zoomResetBtn" textAlignment="CENTER"/>
        </JFXRippler>

        <JFXRippler styleClass="jfx-rippler" layoutY="3">
            <HBox.margin>
                <Insets left="10"/>
            </HBox.margin>
            <Label maxHeight="1.8" fx:id="zoomBigBtn" textAlignment="CENTER"/>
        </JFXRippler>

        <JFXRippler styleClass="jfx-rippler" layoutY="3">
            <HBox.margin>
                <Insets left="10"/>
            </HBox.margin>
            <Label maxHeight="1.8" fx:id="zoomSmallBtn" textAlignment="CENTER"/>
        </JFXRippler>

        <JFXRippler styleClass="jfx-rippler" layoutY="3">
            <HBox.margin>
                <Insets left="10"/>
            </HBox.margin>
            <Label maxHeight="1.8" fx:id="rotateBtn" textAlignment="CENTER"/>
        </JFXRippler>

        <JFXRippler styleClass="jfx-rippler" layoutY="3">
            <HBox.margin>
                <Insets left="10"/>
            </HBox.margin>
            <Label maxHeight="1.8" fx:id="pickupColorBtn" textAlignment="CENTER"/>
        </JFXRippler>

        <Label fx:id="currentSizeLabel" textAlignment="CENTER">
            <HBox.margin>
                <Insets left="30" top="6"/>
            </HBox.margin>
        </Label>

        <Label fx:id="fixWholeWidthLabel" prefHeight="25" prefWidth="25">
            <HBox.margin>
                <Insets left="30" top="2" />
            </HBox.margin>
        </Label>

        <Label fx:id="colorInfoLabel" textAlignment="CENTER" style="-fx-font-size: 15px;">
            <HBox.margin>
                <Insets left="10" top="6" />
            </HBox.margin>
        </Label>
    </HBox>

    <Drag2ScrollPane layoutY="30" fx:id="draggerScrollPane">
        <StackPane fx:id="imageContentPane">
            <RotatablePaneLayouter fx:id="rotatablePane" />
        </StackPane>
    </Drag2ScrollPane>

</AnchorPane>
