<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import com.allan.atools.ui.SwitchControl?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Hyperlink?>
<?import com.jfoenix.controls.JFXComboBox?>
<?import javafx.scene.control.ScrollPane?>
<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:id="vbox_id"
            styleClass="custom-main-bg"
            fitToWidth="true"
            prefHeight="650" prefWidth="650">
    <VBox minWidth="0">
        <!--- 第1部分 -->
        <Label text="%setting.mainUiSize" styleClass="normal-label">
            <VBox.margin>
                <Insets left="3" top="20"/>
            </VBox.margin>
        </Label>
        <HBox fx:id="mainUiSizeSegmentBox">
            <VBox.margin>
                <Insets left="20" top="8"/>
            </VBox.margin>
        </HBox>

        <Label text="%setting.language" styleClass="normal-label">
            <VBox.margin>
                <Insets left="3" top="18"/>
            </VBox.margin>
        </Label>
        <JFXComboBox fx:id="localesComboBox" accessibleText="%setting.language"
                     styleClass="setting-combo"
                     prefWidth="240" minWidth="240" maxWidth="240"
                     prefHeight="34" minHeight="34" maxHeight="34">
            <VBox.margin>
                <Insets left="20" top="8"/>
            </VBox.margin>
        </JFXComboBox>

        <Label text="%setting.appTheme" styleClass="normal-label">
            <VBox.margin>
                <Insets left="3" top="18"/>
            </VBox.margin>
        </Label>
        <JFXComboBox fx:id="appThemeComboBox" accessibleText="%setting.appTheme"
                     styleClass="setting-combo app-theme-combo"
                     prefWidth="240" minWidth="240" maxWidth="240"
                     prefHeight="34" minHeight="34" maxHeight="34">
            <VBox.margin>
                <Insets left="20" top="8"/>
            </VBox.margin>
        </JFXComboBox>

        <Label text="%setting.selectFont" styleClass="normal-label">
            <VBox.margin>
                <Insets left="3" top="18"/>
            </VBox.margin>
        </Label>
        <HBox fx:id="fontThemeSegmentBox">
            <VBox.margin>
                <Insets left="20" top="8"/>
            </VBox.margin>
        </HBox>

        <HBox fx:id="fontCustomLinkBox" alignment="CENTER_LEFT">
            <VBox.margin>
                <Insets top="8" left="20"/>
            </VBox.margin>
            <Hyperlink fx:id="fontCustomLink" styleClass="myhyperlink" visible="false"
                       minWidth="0" maxWidth="Infinity"/>
        </HBox>

        <!--- 第2部分 -->
        <Label text="%setting.editorAreaTitle" styleClass="title-label-big">
            <VBox.margin>
                <Insets top="64" left="3"/>
            </VBox.margin>
        </Label>

        <SwitchControl fx:id="cycleNextBtn" text="%setting.cycleNext" selected="true">
            <VBox.margin>
                <Insets left="20" top="10"/>
            </VBox.margin>
        </SwitchControl>

        <SwitchControl fx:id="editorLineNumberVisibleBtn" text="%setting.showEditorLineNum" selected="true">
            <VBox.margin>
                <Insets top="8" left="20"/>
            </VBox.margin>
        </SwitchControl>

        <!--- 第3部分 -->
        <Label text="%search" styleClass="title-label-big">
            <VBox.margin>
                <Insets top="64" left="3"/>
            </VBox.margin>
        </Label>

        <SwitchControl fx:id="resultAreaWrapBtn" text="%setting.resultAutoEnter">
            <VBox.margin>
                <Insets left="20" top="10"/>
            </VBox.margin>
        </SwitchControl>

        <SwitchControl fx:id="resultIfHasNumBtn" text="%setting.showLineNum" selected="true">
            <VBox.margin>
                <Insets top="8" left="20"/>
            </VBox.margin>
        </SwitchControl>

        <SwitchControl fx:id="resultAreaInNewBtn" text="%setting.showInNewWindow">
            <VBox.margin>
                <Insets top="8" left="20"/>
            </VBox.margin>
        </SwitchControl>

        <!--- 第4部分 -->
        <Label text="%setting.others" styleClass="title-label-big">
            <VBox.margin>
                <Insets top="64" left="3"/>
            </VBox.margin>
        </Label>

        <SwitchControl fx:id="openLastFileBtn" text="%setting.autoOpenLastName" selected="true">
            <VBox.margin>
                <Insets left="20" top="10"/>
            </VBox.margin>
        </SwitchControl>

        <SwitchControl fx:id="hdScreenBtn2" text="%setting.hdscreenname">
            <VBox.margin>
                <Insets top="8" left="20"/>
            </VBox.margin>
        </SwitchControl>

    </VBox>

</ScrollPane>
